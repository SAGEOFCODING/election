# Server Configuration
PORT=3000
NODE_ENV=development

# Google APIs
# Get this from Google Cloud Console
GOOGLE_API_KEY=your_google_api_key_here

# Google Custom Search API
# Get this from programmablesearchengine.google.com
GOOGLE_CUSTOM_SEARCH_API_KEY=your_key_here
GOOGLE_SEARCH_ENGINE_ID=your_cx_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_key_here

# Firebase Client Configuration (Frontend Auth)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id

# Firebase Admin SDK credentials (Server-side)
# Get from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key_with_escaped_newlines"

# Firebase Client Configuration (used in client-side JS, injected or copied over)
VITE_FIREBASE_API_KEY=your_client_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
